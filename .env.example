# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=
# Buat string acak panjang untuk mengakses dashboard /admin dan endpoint admin.
ADMIN_API_KEY=
ADMIN_USERNAME=admin
# URL publik untuk link invoice yang dikirim ke customer.
PUBLIC_APP_URL=http://localhost:5173

# Pembayaran memakai QRIS statis pada src/images/qris.png dan diverifikasi manual.
PAYMENT_PROVIDER=manual-qris

# WhatsApp Web bot. Set true only on a server/session that will scan the QR.
WHATSAPP_BOT_ENABLED=false

# AI chatbot WhatsApp (opsional). Jangan pernah pakai awalan VITE_.
# Buat key di https://console.groq.com/keys. Free tier memiliki batas kuota.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Fallback otomatis ketika Groq limit/tidak tersedia. Buat key di Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Alternatif berbayar bila dibutuhkan:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# DANA QRIS (keep these values server-side only; never prefix them with VITE_)
DANA_API_URL=
DANA_PARTNER_ID=
DANA_MERCHANT_ID=
DANA_CLIENT_ID=
DANA_PRIVATE_KEY_PATH=
DANA_WEBHOOK_SECRET=
